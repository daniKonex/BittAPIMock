{
    "name": "biit/api-mock",
    "description": "Mock API for Biit/Sage integration with KonexCommerce",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.4",
        "firebase/php-jwt": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "support": {
        "source": "https://github.com/biit/api-mock"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
